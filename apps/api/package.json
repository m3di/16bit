{
  "name": "@16bit/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch src/server.ts",
    "start": "node src/server.ts",
    "migrate": "node --env-file-if-exists=../../.env src/migrate.ts",
    "seed:build-hub": "node --env-file-if-exists=../../.env src/seed-build-hub.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@16bit/core": "workspace:*",
    "fastify": "5.12.8",
    "kysely": "0.29.9",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
