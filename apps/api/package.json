{
  "name": "@16bit/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch src/server.ts",
    "start": "node src/server.ts",
    "migrate": "node --env-file-if-exists=../../.env src/migrate.ts",
    "seed": "node --env-file-if-exists=../../.env src/seed.ts",
    "seed:build-hub": "node --env-file-if-exists=../../.env src/seed-build-hub.ts",
    "seed:large": "node --env-file-if-exists=../../.env src/seed-large.ts",
    "account:reset-password": "node --env-file-if-exists=../../.env src/account-reset-password.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:budgets": "vitest run --config vitest.budgets.config.ts"
  },
  "dependencies": {
    "@16bit/core": "workspace:*",
    "@fastify/static": "10.1.11",
    "@fastify/websocket": "11.3.7",
    "fastify": "5.12.8",
    "kysely": "0.29.9",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "ws": "8.23.0"
  }
}
