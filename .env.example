# Copy to .env (`pnpm dev` does this for you on the first run).
# Values already set in your shell take precedence over this file.

# Postgres. The defaults match `docker compose up -d db`. Without Docker, point both at any
# Postgres you run yourself; they name the same database with two different users.
#
# MIGRATION_DATABASE_URL: the owner of the tables. Migrations, seed scripts, the password-reset
# command, and the test suite's throwaway databases use it. Row-level security does not apply.
MIGRATION_DATABASE_URL=postgres://sixteenbit:sixteenbit@127.0.0.1:55432/sixteenbit
# DATABASE_URL: the API's own login role, a member of `sixteenbit_app`, under row-level
# security (#44). `pnpm db:migrate` creates it with this user and password if it doesn't exist.
# The API refuses to serve as the owner, a superuser, or a role that bypasses RLS.
DATABASE_URL=postgres://sixteenbit_api:sixteenbit_api@127.0.0.1:55432/sixteenbit

# Host port the compose `db` service publishes. Not 5432, so it does not clash
# with a Postgres you already run. If you change it, change both database URLs too.
POSTGRES_PORT=55432

# Host port `docker compose up` serves the full app on (API and dashboard).
APP_PORT=8080

# Address the API listens on. The web dev server proxies /v1 here.
HOST=127.0.0.1
PORT=3000

# Sign in at /sign-in as a person `pnpm seed` creates, for example owner@example.com, with
# the development password in README.md. Agents use the key `pnpm seed` prints once.

# Session cookies are sent with `Secure` unless this is `false`. Set it to `false` only for
# local development over plain HTTP in a browser that refuses Secure cookies on localhost.
# COOKIE_SECURE=false

# With NODE_ENV=production the seeds' published development password is refused at sign-in,
# as a new account's password when accepting an invite, and by `pnpm account:reset-password`.
# `1` accepts it anyway. compose.yaml sets it for its 127.0.0.1-only stack; never set
# it on a deployment. Without NODE_ENV=production it has no effect.
# ALLOW_DEV_PASSWORD=1

# Optional. Repository `pnpm seed:build-hub` imports from, as owner/name.
# Defaults to the repository of the current checkout.
# BUILD_HUB_REPO=m3di/16bit

# Optional. Where `pnpm e2e` points the browser. Defaults to the web dev server.
# E2E_BASE_URL=http://localhost:5173
# Optional. Port of the web dev server `pnpm e2e` starts when nothing is running on it.
# E2E_WEB_PORT=5173
